# cp .env.example .env して埋める。.env は .gitignore 済み。
#
# このプロジェクトにAPIキーは無い。公開されている価格ページを読むだけなので、
# 秘密にすべき値は存在しない（成果リンクは config/tools.yaml に直接書く）。

# 公開URL。GitHub Pages のプロジェクトページなら
#   https://<ユーザー名>.github.io/<リポジトリ名>
# 独自ドメインなら https://example.com
SITE_BASE_URL=https://example.github.io/tierlog

# Search Console の「HTMLタグ」方式で表示される content の値だけを入れる。
# タグ全体ではなく content="" の中身。未設定なら meta 自体が出力されない。
GOOGLE_SITE_VERIFICATION=
